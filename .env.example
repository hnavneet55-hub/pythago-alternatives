DATABASE_URL=            # Postgres connection string (Neon on Vercel)
ENCRYPTION_KEY=          # openssl rand -base64 32  (encrypts Shopify secrets in the database)
SESSION_SECRET=          # openssl rand -base64 32
CRON_SECRET=             # random string; Vercel Cron sends it as a Bearer token
DASHBOARD_PASSWORD=      # team login password
REPORTING_CURRENCY=EUR   # currency used when viewing all stores together
SHOPIFY_API_VERSION=2026-07
SHOPIFY_INITIAL_SYNC_DAYS=60
